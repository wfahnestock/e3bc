# Contact form email settings (Resend).
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — credentials never get committed.
# When deploying (e.g. Vercel), add these same variables in the host's
# environment settings.

# One-time setup:
#   1. Create a free account at https://resend.com
#   2. Domains → Add Domain → your site domain, then add the DNS records
#      Resend shows you (SPF + DKIM) at your domain registrar. Verification
#      usually completes within minutes.
#   3. API Keys → Create API Key ("Sending access" is enough) → paste below.
#
# Testing before the domain is verified: set CONTACT_FROM=onboarding@resend.dev
# — Resend allows that sender in test mode, but only delivers to the email
# address you signed up to Resend with.

RESEND_API_KEY=

# Sender address on your verified domain. Doesn't need to be a real mailbox —
# something like website@yourdomain.com works. Visitors' replies go to the
# visitor's address (Reply-To), not here.
CONTACT_FROM=

# Where form submissions are delivered — your Outlook business address.
CONTACT_TO=
